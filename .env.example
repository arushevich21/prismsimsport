# Copy to .env.local for local development. Real values live in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses database rules; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Discord webhooks for coaching applications and the legacy question form.
DISCORD_WEBHOOK_URL=
DISCORD_QA_WEBHOOK_URL=
# Public invite link, e.g. https://discord.gg/abc123. Powers every "Join the Discord"
# button and the member/online counts on /community.
NEXT_PUBLIC_DISCORD_INVITE_URL=
# Cal.com webhook signing secret (Cal.com → Settings → Developer → Webhooks).
CAL_WEBHOOK_SECRET=
# Optional: base URL used in Discord notification links. Defaults to https://prismsimsport.app
NEXT_PUBLIC_SITE_URL=

# Discord bot (see docs/DISCORD_SETUP.md). Optional: without a token the site
# falls back to the webhooks above. Leave any role/channel blank to skip it.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_ROLE_ACADEMY=
DISCORD_ROLE_ACADEMY_LMU=
DISCORD_ROLE_ACADEMY_ACC=
DISCORD_ROLE_COACH=
DISCORD_ROLE_LMU_DRIVER=
DISCORD_ROLE_ACC_DRIVER=
DISCORD_CHANNEL_LINEUPS=
DISCORD_CHANNEL_RESULTS=
DISCORD_CHANNEL_STAFF=
DISCORD_CHANNEL_CAPTAINS=
DISCORD_CATEGORY_APPLICATIONS=
# "true" adds people to the Discord server when they sign in to the site.
NEXT_PUBLIC_DISCORD_AUTO_JOIN=

# Timezone for times printed on generated lineup graphics (IANA name).
TEAM_TIMEZONE=America/New_York
