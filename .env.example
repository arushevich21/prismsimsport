# Copy to .env.local for local development. Real values live in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses database rules; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Discord webhooks for coaching applications and the legacy question form.
DISCORD_WEBHOOK_URL=
DISCORD_QA_WEBHOOK_URL=
# Public invite link, e.g. https://discord.gg/abc123. Powers every "Join the Discord"
# button and the member/online counts on /community.
NEXT_PUBLIC_DISCORD_INVITE_URL=
# Cal.com webhook signing secret (Cal.com → Settings → Developer → Webhooks).
CAL_WEBHOOK_SECRET=
# Optional: base URL used in Discord notification links. Defaults to https://prismsimsport.app
NEXT_PUBLIC_SITE_URL=
